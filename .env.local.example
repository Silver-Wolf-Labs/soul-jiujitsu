# ─────────────────────────────────────────────────────────────────
# Gym Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# Add these same values to Vercel: Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── Supabase (required) ─────────────────────────────────────────
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Stripe (required) ───────────────────────────────────────────
# Find these in your Stripe Dashboard: Developers → API Keys
# Use test-mode keys (sk_test_ / whsec_) for development
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
# Webhook secret — from `stripe listen` CLI or Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ── Site URL (required for production) ──────────────────────────
# Used for Stripe checkout redirects, email links, etc.
# Defaults to http://localhost:3000 in development
NEXT_PUBLIC_SITE_URL=https://yourgym.com

# ── Super Admin (recommended) ───────────────────────────────────
# Password for the /super-admin platform console.
# Must be at least 16 characters. Generate one:
#   openssl rand -base64 24
# SUPER_ADMIN_PASSWORD=your-very-strong-password-here

# ── Stripe Currency (optional) ─────────────────────────────────
# ISO 4217 currency code. Defaults to "usd" if not set.
# STRIPE_CURRENCY=usd

# ── Cron (optional) ─────────────────────────────────────────────
# Secret for cron job endpoints (e.g. scheduled blog publishing)
# CRON_SECRET=your-cron-secret-here
