{
  "name": "soul-jiujitsu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:smoke": "playwright test e2e/tests/smoke",
    "test:e2e:a11y": "playwright test --project=a11y",
    "test:e2e:auth": "playwright test --project=authenticated",
    "test:e2e:visual": "E2E_VISUAL=1 playwright test --project=visual",
    "test:e2e:update-snapshots": "E2E_VISUAL=1 playwright test --project=visual --update-snapshots",
    "test:e2e:report": "playwright show-report e2e/.artifacts/html-report",
    "test:e2e:dashboard": "npx tsx e2e/reporters/build-dashboard.ts e2e/.artifacts/dashboard",
    "test:e2e:install": "playwright install --with-deps chromium webkit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "aws-rum-web": "^1.22.0",
    "lucide-react": "^1.7.0",
    "next": "^15.5.15",
    "next-intl": "^4.13.5",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "stripe": "^21.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.15",
    "jsdom": "^29.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "vite": "^8.0.8"
  }
}
